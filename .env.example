# Required: PostgreSQL connection string (Neon, Supabase, Railway or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: long random string for signing admin sessions (generate: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run setup` (change the password after first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Public URL of the site (used for canonical URLs and sitemap before Site identity is filled in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: AI providers. All optional; the site runs with none and disables AI buttons.
# Keys can also be added later in Admin > AI.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: SMTP for form notification emails. Without it, submissions are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
