# Required: PostgreSQL connection string (Neon, Supabase, Railway or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: long random string for signing admin sessions (generate: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run setup` (change the password after first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional. Canonical URLs, sitemap and emails use the domain the site is opened on automatically.
# Set this only to force one fixed domain (or set it in Admin > Site settings > Primary domain).
NEXT_PUBLIC_SITE_URL=

# Optional: AI providers. All optional; the site runs with none and disables AI buttons.
# Keys can also be added later in Admin > AI.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: SMTP for notifications, the automatic thank-you email and campaigns. Without it, submissions are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
